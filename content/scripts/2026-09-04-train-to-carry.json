  "voiceover": [
    {
      "t": 0,
      "text": "Fitness keeps telling you to get smaller. Your life disagrees."
    },
    {
      "t": 5.9,
      "text": "Your week never asks you to shrink. It asks you to carry, lift, climb and hold."
    },
    {
      "t": 14.8,
      "text": "Push strength opens heavy doors and gets you up off the floor."
    },
    {
      "t": 22.3,
      "text": "Pull strength hauls the suitcase off the carousel and the shopping up the stairs."
    },
    {
      "t": 29.8,
      "text": "Squat strength is every staircase with something in your arms."
    },
    {
      "t": 36.3,
      "text": "Hinge strength picks things up off the floor without a second thought."
    },
    {
      "t": 43.8,
      "text": "Core strength holds it all steady, including the child on your hip."
    },
    {
      "t": 50.3,
      "text": "Train to carry, and the week gets lighter. What did you carry today? Tell me in the comments."
    }
